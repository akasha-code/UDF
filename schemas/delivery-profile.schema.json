{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/akasha-code/UDF/schemas/delivery-profile.schema.json",
  "title": "UDF Delivery Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "assessment_id", "documentation_depth", "assurance_level", "human_oversight", "capabilities", "rationale", "requires_human_confirmation"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "assessment_id": {"type": "string", "minLength": 1},
    "documentation_depth": {"enum": ["minimal", "light", "standard", "complete", "regulated"]},
    "assurance_level": {"enum": ["low", "medium", "high", "critical"]},
    "human_oversight": {"enum": ["advisory", "approval_on_effect", "supervised", "mandatory"]},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "reason"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]+$"},
          "status": {"enum": ["required", "recommended", "optional", "not_applicable", "discouraged"]},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "rationale": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "unknowns": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "requires_human_confirmation": {"const": true}
  }
}
